; Minimal stand-in for the XPK developer kit's xpk/xpk.i, written for
; xfd-native. Only what xfdmaster's XPK slave needs: the XpkUnpack() tags,
; the error codes, XPK_MARGIN and the library vector offset. Values from
; xpk/xpk.h and xpkmaster_lib.fd (##bias 36).
; Part of xfd-native; LGPL-2.1-or-later (see ../../THIRD_PARTY.md).

	IFND	XPK_XPK_I
XPK_XPK_I	SET	1

TAG_DONE	EQU	0
TAG_IGNORE	EQU	1
TAG_MORE	EQU	2
TAG_SKIP	EQU	3
TAG_USER	EQU	$80000000

XPK_TagBase	EQU	TAG_USER+('X'<<8)+'P'
XPK_InBuf	EQU	XPK_TagBase+$03
XPK_OutBuf	EQU	XPK_TagBase+$12
XPK_InLen	EQU	XPK_TagBase+$20
XPK_OutBufLen	EQU	XPK_TagBase+$21
XPK_GetOutLen	EQU	XPK_TagBase+$22
XPK_Password	EQU	XPK_TagBase+$24

XPK_MARGIN	EQU	256

XPKERR_OK		EQU	0
XPKERR_NOFUNC		EQU	-1
XPKERR_NOFILES		EQU	-2
XPKERR_IOERRIN		EQU	-3
XPKERR_IOERROUT		EQU	-4
XPKERR_CHECKSUM		EQU	-5
XPKERR_VERSION		EQU	-6
XPKERR_NOMEM		EQU	-7
XPKERR_LIBINUSE		EQU	-8
XPKERR_WRONGFORM	EQU	-9
XPKERR_SMALLBUF		EQU	-10
XPKERR_LARGEBUF		EQU	-11
XPKERR_WRONGMODE	EQU	-12
XPKERR_NEEDPASSWD	EQU	-13
XPKERR_CORRUPTPKD	EQU	-14
XPKERR_MISSINGLIB	EQU	-15
XPKERR_BADPARAMS	EQU	-16
XPKERR_EXPANSION	EQU	-17
XPKERR_NOMETHOD		EQU	-18
XPKERR_ABORTED		EQU	-19
XPKERR_TRUNCATED	EQU	-20
XPKERR_WRONGCPU		EQU	-21
XPKERR_PACKED		EQU	-22
XPKERR_NOTPACKED	EQU	-23
XPKERR_FILEEXISTS	EQU	-24
XPKERR_OLDMASTLIB	EQU	-25
XPKERR_OLDSUBLIB	EQU	-26
XPKERR_NOCRYPT		EQU	-27
XPKERR_NOINFO		EQU	-28
XPKERR_LOSSY		EQU	-29
XPKERR_NOHARDWARE	EQU	-30
XPKERR_BADHARDWARE	EQU	-31
XPKERR_WRONGPW		EQU	-32
XPKERR_UNKNOWN		EQU	-33
XPKERR_REQTIMEOUT	EQU	-34

_LVOXpkUnpack	EQU	-48

	ENDC
